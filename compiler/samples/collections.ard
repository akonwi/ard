use ard/list as List

use go:fmt

fn main() {
  // List::new<T>() names the element type, so the binding needs no
  // annotation; `mut` references the fresh empty list for interior mutation.
  let numbers = mut List::new<Int>()
  fmt::Println("numbers.size = {numbers.size()}")

  fmt::Println("adding numbers from 0 to 10")
  for i in 0..10 {
    numbers.push(i)
  }

  fmt::Println("numbers.size = {numbers.size()}")
  for n in numbers {
    fmt::Println(n)
  }

  match numbers.at(6) {
    value => fmt::Println("7th element = {value}"),
    _ => fmt::Println("7th element missing"),
  }
}
